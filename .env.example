# Vercel 프로젝트의 Environment Variables 설정에 아래 값을 등록하세요.
# 절대로 이 키들을 클라이언트(HTML/JS)나 저장소에 직접 하드코딩하지 마세요.

# OpenAI Realtime API (AI 사전 상담 음성 대화 / 결과 요약)
OPENAI_API_KEY=sk-...

# Vercel KV (Upstash Redis) — 프로젝트에 "KV" 스토리지를 연결하면 아래 두 값이 자동으로 채워집니다.
# 원격 사전상담(링크로 접속) 결과를 사회복지사가 확인하기 전까지 짧게 임시 보관하는 용도입니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
