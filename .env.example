# Vercel 프로젝트의 Environment Variables 설정에 아래 값을 등록하세요.
# 절대로 이 키들을 클라이언트(HTML/JS)나 저장소에 직접 하드코딩하지 마세요.

# OpenAI Realtime API (AI 사전 상담 음성 대화 / 결과 요약)
OPENAI_API_KEY=sk-...

# Redis(KV) — 원격 사전상담(링크로 접속) 결과를 사회복지사가 확인하기 전까지 짧게 임시 보관하는 용도입니다.
# Vercel Storage에서 "Upstash for Redis"(또는 Upstash)를 만들어 이 프로젝트에 연결하면
# 아래 둘 중 한 쌍의 이름으로 자동 채워집니다(코드는 둘 다 인식합니다). 직접 입력하지 않아도 됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 또는
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
