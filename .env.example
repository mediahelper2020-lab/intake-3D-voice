# Vercel 프로젝트의 Environment Variables 설정에 아래 값을 등록하세요.
# 절대로 이 키들을 클라이언트(HTML/JS)나 저장소에 직접 하드코딩하지 마세요.

# OpenAI Realtime API (AI 사전 상담 음성 대화 / 결과 요약)
OPENAI_API_KEY=sk-...

# Vercel KV (Upstash Redis) — 프로젝트에 "KV" 스토리지를 연결하면 아래 두 값이 자동으로 채워집니다.
# 원격 사전상담(문자 링크) 결과를 사회복지사가 확인하기 전까지 짧게 임시 보관하는 용도입니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 문자(SMS/LMS) 발송 — 기본 구현은 알리고(Aligo)를 사용합니다. 다른 업체를 쓰신다면
# api/send-sms.js의 sendViaAligo() 부분만 해당 업체 API 호출로 교체하면 됩니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
